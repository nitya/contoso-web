{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro: development server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "Local\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Astro: preview build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run preview",
      "serverReadyAction": {
        "pattern": "Local\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { formatPrice, getCategories, getProductRating, getProducts } from "../../lib/catalog";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const rating = await getProductRating(product);
const categories = await getCategories();
const relatedProducts = categories
  .find((category) => category.name === product.category)
  ?.products.filter((item) => item.slug !== product.slug)
  .slice(0, 3) ?? [];
---

<BaseLayout
  title={`${product.name} | Contoso Outdoors`}
  description={product.description}
>
  <section class="page-container product-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href={`/products/?category=${product.category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`}>
        {product.category}
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="product-detail__layout">
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery__main">
          <img
            src={product.images[0]}
            alt={product.name}
            width="900"
            height="900"
            fetchpriority="high"
            data-gallery-main
          />
        </div>
        <div class="product-gallery__thumbs" role="group" aria-label="Product images">
          {product.images.map((image, index) => (
            <button
              class:list={["product-gallery__thumb", index === 0 && "is-active"]}
              type="button"
              data-gallery-thumb
              data-image={image}
              data-alt={`${product.name}, view ${index + 1}`}
              aria-label={`Show product image ${index + 1}`}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <img src={image} alt="" width="112" height="112" loading="lazy" />
            </button>
          ))}
        </div>
      </div>

      <div class="product-detail__info">
        <p class="eyebrow">{product.brand} · {product.category}</p>
        <h1>{product.name}</h1>
        <div class="product-detail__rating">
          <span class="rating-stars" style={`--rating: ${(rating.average / 5) * 100}%`} aria-hidden="true">★★★★★</span>
          <span>{rating.average.toFixed(1)} <span class="muted">({rating.count} reviews)</span></span>
        </div>
        <p class="product-detail__price">{formatPrice(product.price)}</p>
        <p class="product-detail__description">{product.description}</p>

        <div class="purchase-controls">
          <div class="quantity-control" role="group" aria-label="Quantity">
            <button type="button" data-quantity-step="-1" aria-label="Decrease quantity">−</button>
            <label class="sr-only" for="product-quantity">Quantity</label>
            <input id="product-quantity" type="number" min="1" max="99" value="1" inputmode="numeric" data-quantity />
            <button type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
          </div>
          <button class="button button--primary add-to-cart" type="button" data-add-to-cart>
            Add to Cart
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
          </button>
        </div>
        <p class="cart-feedback" data-cart-feedback role="status" aria-live="polite"></p>

        <div class="product-note">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-3Z"></path><path d="m8.5 12 2.2 2.2 4.8-5"></path></svg>
          <p>Thoughtfully chosen gear, ready for the long way around.</p>
        </div>
      </div>
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="page-container related-products">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Keep exploring</p>
          <h2>More from {product.category}</h2>
        </div>
        <a class="text-link" href={`/products/?category=${product.category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`}>
          Shop the collection <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="product-grid product-grid--related">
        {relatedProducts.map((item) => <ProductCard product={item} />)}
      </div>
    </section>
  )}
</BaseLayout>

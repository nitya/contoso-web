---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProductCard from "../components/ProductCard.astro";
import categories from "../../public/categories.json";
---

<Layout title="Contoso Outdoors | Explore farther">
  <Header active="home" />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <p class="eyebrow">Built for the outside</p>
        <h1 id="hero-title">Find your way<br />to <em>somewhere</em> wild.</h1>
        <p>Trail-tested gear, camp essentials, and everyday equipment for every route ahead.</p>
        <a class="primary-button" href="/products/">
          All products
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
        </a>
      </div>
      <div class="hero-stat">
        <strong>20</strong>
        <span>adventure-ready essentials</span>
      </div>
    </section>

    <section class="shop-section" id="categories" aria-labelledby="shop-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Shop the collection</p>
          <h2 id="shop-title">Gear for every path</h2>
        </div>
        <a class="all-products-link" href="/products/">All products <span aria-hidden="true">→</span></a>
      </div>

      <div class="category-carousels">
        {categories.map((category, categoryIndex) => (
          <section class="category-carousel" aria-labelledby={`category-${categoryIndex}`}>
            <div class="category-heading">
              <div>
                <p class="category-count">{String(categoryIndex + 1).padStart(2, "0")} / {category.products.length} products</p>
                <h3 id={`category-${categoryIndex}`}>{category.name}</h3>
              </div>
              <div class="carousel-controls" aria-label={`${category.name} carousel controls`}>
                <button type="button" class="carousel-prev" aria-label={`Previous ${category.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M10 7l-5 5 5 5"></path></svg>
                </button>
                <button type="button" class="carousel-next" aria-label={`Next ${category.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
                </button>
              </div>
            </div>
            <div class="carousel-track">
              {category.products.map((product) => (
                <div class="carousel-item">
                  <ProductCard product={product} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="feature-strip" aria-label="Contoso Outdoor benefits">
      <div>
        <span>01</span>
        <h3>Trail tested</h3>
        <p>Field-ready equipment selected for real conditions.</p>
      </div>
      <div>
        <span>02</span>
        <h3>Easy returns</h3>
        <p>Try it outdoors. Return it within 30 days if it is not right.</p>
      </div>
      <div>
        <span>03</span>
        <h3>Adventure support</h3>
        <p>Help choosing the right gear for your next route.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand footer-brand" href="/" aria-label="Contoso Outdoors home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 44 44"><path d="M8 31 22 8l14 23H8Z"></path><path d="m15 31 7-11 7 11"></path></svg>
      </span>
      <span><strong>CONTOSO</strong><small>OUTDOORS</small></span>
    </a>
    <p>Equipment for a life outside.</p>
    <div class="footer-links">
      <a href="/products/">All products</a>
      <a href="/#categories">Categories</a>
      <a href="mailto:hello@contosooutdoors.example">Support</a>
    </div>
  </footer>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>(".category-carousel").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>(".carousel-track");
    const previous = carousel.querySelector<HTMLButtonElement>(".carousel-prev");
    const next = carousel.querySelector<HTMLButtonElement>(".carousel-next");
    const controls = carousel.querySelector<HTMLElement>(".carousel-controls");
    const item = track?.querySelector<HTMLElement>(".carousel-item");

    const distance = () => {
      if (!item) return 320;
      const gap = 18;
      return item.getBoundingClientRect().width + gap;
    };

    const updateControls = () => {
      if (!track || !controls) return;
      const hasOverflow = track.scrollWidth > track.clientWidth + 1;
      controls.hidden = !hasOverflow;
      if (previous) previous.hidden = !hasOverflow || track.scrollLeft <= 1;
      if (next) {
        const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
        next.hidden = !hasOverflow || atEnd;
      }
    };

    previous?.addEventListener("click", () => {
      track?.scrollBy({ left: -distance(), behavior: "smooth" });
    });
    next?.addEventListener("click", () => {
      track?.scrollBy({ left: distance(), behavior: "smooth" });
    });

    if (track) {
      updateControls();
      track.addEventListener("scroll", updateControls);
      window.addEventListener("resize", updateControls);
      if ("ResizeObserver" in window) {
        new ResizeObserver(updateControls).observe(track);
      }
    }
  });
</script>

---
import type { Category } from "../lib/catalog";
import ProductCard from "./ProductCard.astro";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const trackId = `collection-${category.slug}`;
---

<section class="collection-section" aria-labelledby={`${trackId}-title`}>
  <div class="collection-heading">
    <div>
      <p class="eyebrow">Explore the collection</p>
      <h2 id={`${trackId}-title`}>{category.name}</h2>
      <p class="collection-heading__description">{category.description}</p>
    </div>
    <div class="collection-heading__actions">
      <a class="text-link" href={`/products/?category=${category.slug}`}>
        Shop {category.name}
        <span aria-hidden="true">↗</span>
      </a>
      <div class="carousel-controls" data-carousel-controls hidden>
        <button
          class="carousel-arrow"
          type="button"
          data-carousel-prev
          aria-label={`Scroll ${category.name} products left`}
          aria-controls={trackId}
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button
          class="carousel-arrow"
          type="button"
          data-carousel-next
          aria-label={`Scroll ${category.name} products right`}
          aria-controls={trackId}
          hidden
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="carousel" data-carousel>
    <div class="carousel-track" id={trackId} data-carousel-track>
      {category.products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>

---
interface Props {
  active?: "home" | "shop";
}

const { active = "home" } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Contoso Outdoors home">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 44 44" role="img">
        <path d="M8 31 22 8l14 23H8Z"></path>
        <path d="m15 31 7-11 7 11"></path>
      </svg>
    </span>
    <span>
      <strong>CONTOSO</strong>
      <small>OUTDOORS</small>
    </span>
  </a>

  <nav class="main-nav" aria-label="Primary navigation">
    <a class={active === "home" ? "active" : ""} href="/">Home</a>
    <a class={active === "shop" ? "active" : ""} href="/products/">All Products</a>
    <a href="/#categories">Categories</a>
  </nav>

  <div class="header-actions">
    <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch color mode">
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 15.3A8.5 8.5 0 0 1 8.7 4a8.5 8.5 0 1 0 11.3 11.3Z"></path>
      </svg>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
    <button class="icon-button search-button" type="button" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const themeMeta = document.querySelector<HTMLMetaElement>("#theme-color");

  function syncThemeControl() {
    const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    if (!toggle) return;
    toggle.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
    toggle.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
  }

  syncThemeControl();

  toggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("contoso-theme", nextTheme);
    themeMeta?.setAttribute("content", nextTheme === "dark" ? "#17352f" : "#faf6df");
    syncThemeControl();
  });
</script>

<header class="site-header">
  <div class="page-container site-header__inner">
    <a class="brand" href="/" aria-label="Contoso Outdoors home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 42 42" fill="none">
          <path d="M21 4 38 35H4L21 4Z" fill="currentColor" />
          <path d="m21 17 10 18H11l10-18Z" fill="var(--page)" />
        </svg>
      </span>
      <span class="brand__wordmark">CONTOSO <span>OUTDOORS</span></span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/products/">All Products</a>
    </nav>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
    >
      <svg data-theme-sun viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
      </svg>
      <svg data-theme-moon viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.2 15.3A8.3 8.3 0 0 1 8.7 3.8 8.3 8.3 0 1 0 20.2 15.3Z"></path>
      </svg>
      <span data-theme-label>Dark mode</span>
    </button>
  </div>
</header>
